<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:thicknessRatio="14" android:useLevel="false">
            <solid android:color="#333F4E" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="135" android:toDegrees="135">
            <shape android:shape="ring" android:thicknessRatio="14" android:useLevel="true">
                <gradient android:endColor="#00D2FF" android:startColor="#0066CC" android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
